# Stone Server tester .env — auto-generated on first run.
# All values below are local to this machine. Do NOT share this file.

# ── Image (overridden by update.* to bump tag) ───────────────────────────────
APP_IMAGE=ghcr.io/snoowood/stone_server:sha-ae91a4b

# ── Database (random per-machine) ────────────────────────────────────────────
DB_USER=stone
DB_PASSWORD=__DB_PASSWORD__
DB_NAME=stone_server

# ── JWT signing key (random per-machine, RSA 2048 PKCS1) ────────────────────
JWT_PRIVATE_KEY="__JWT_PRIVATE_KEY__"

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SERVER_PORT=8080
TRUSTED_PROXIES=172.0.0.0/8

# ── Network bindings ────────────────────────────────────────────────────────
# LAN_BIND=127.0.0.1 → only this PC can connect (default, safest)
# LAN_BIND=0.0.0.0   → any device on the LAN can connect (for cross-PC tests)
LAN_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# ── Nginx / SSL ──────────────────────────────────────────────────────────────
DOMAIN=localhost
SSL_CERT=/etc/nginx/certs/selfsigned.crt
SSL_KEY=/etc/nginx/certs/selfsigned.key
