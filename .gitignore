nginx/certs/fullchain.pem
nginx/certs/privkey.pem
# selfsigned.crt / selfsigned.key are local dev certs and are intentionally tracked

# Backup files
*.pgdump

# Local SQLite dev database
*.db
*.db-shm
*.db-wal

*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/vendor/
