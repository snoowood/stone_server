<gameConfig version="1">
  <!-- 가챠(WishCairn pull) -->
  <gacha>
    <pullCost>100</pullCost>                <!-- float, enlightenment 포인트 -->
    <cooldownSeconds>1800</cooldownSeconds> <!-- int, 30분 = 1800초 -->
  </gacha>
  <!-- WishCairn 돌탑 성장 -->
  <cairn>
    <slotCount>5</slotCount>                        <!-- int, 슬롯 수 -->
    <maxLayers>5</maxLayers>                         <!-- int, 완성 필요 레이어 -->
    <spawnIntervalSeconds>30</spawnIntervalSeconds>  <!-- int, 레이어 1단 생성 간격 -->
  </cairn>
</gameConfig>
