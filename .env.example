# ── Docker Compose / PostgreSQL container vars ──────────────────────────────
# Used by docker-compose to configure the postgres container,
# and to construct DB_URL / REDIS_URL for the app service automatically.
DB_USER=stone
DB_PASSWORD=change_me_in_production
DB_NAME=stone_server

# ── App environment variables ────────────────────────────────────────────────
# Note: when running via docker-compose, DB_URL and REDIS_URL are overridden
# automatically using the vars above. The values below are for local
# (non-Docker) development only.
DB_URL=postgres://stone:change_me_in_production@localhost:5432/stone_server?sslmode=disable

REDIS_URL=redis://localhost:6379

# Steam Web API Key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_api_key_here

# Steam Application ID (https://partner.steamgames.com)
STEAM_APP_ID=your_steam_app_id_here

# JWT RS256 private key (PEM, newlines as \n, or multiline in double quotes)
# Generate: openssl genrsa -out private.pem 2048
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Server
SERVER_PORT=8080
APP_ENV=development

# Trusted reverse proxy CIDRs (comma-separated).
# Set to the Docker internal network CIDR when running behind nginx in Compose.
# Leave empty to trust no proxies (direct exposure).
TRUSTED_PROXIES=172.0.0.0/8

# ── Nginx / SSL ──────────────────────────────────────────────────────────────
# Domain served by nginx (used in the server_name directive).
DOMAIN=localhost

# SSL certificate paths inside the nginx container.
# Local dev (self-signed, tracked in git):
SSL_CERT=/etc/nginx/certs/selfsigned.crt
SSL_KEY=/etc/nginx/certs/selfsigned.key
# Production (Let's Encrypt — set these after running deploy.sh):
# SSL_CERT=/etc/letsencrypt/live/your.domain.com/fullchain.pem
# SSL_KEY=/etc/letsencrypt/live/your.domain.com/privkey.pem
